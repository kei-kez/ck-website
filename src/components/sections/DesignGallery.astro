---
import SectionHeader from "@/components/elements/SectionHeader.astro";
import Button from "@/components/ui/Button.astro";

interface Props {
  title?: string;
  description?: string;
}

const { title = "Design & Creative Works ↓", description = "A collection of graphic designs, event posters, and digital artwork." } = Astro.props;

// You can add your image paths and titles here from your Behance collection
const designs = [
  { src: "/ck-website/assets/works/jil41.png", title: "Anniversary Banner" },
  { src: "/ck-website/assets/works/coe.png", title: "Event Backdrop Design" },
  { src: "/ck-website/assets/works/jil43.png", title: "Anniversary Theme Graphic" },
  { src: "/ck-website/assets/works/jil44.png", title: "Anniversary Celebration Design" },  
  { src: "/ck-website/assets/works/id-temp.png", title: "Professional ID Template" },
  { src: "/ck-website/assets/works/mlbb.png", title: "Event Tournament Promo" },
];

---

<section class="py-8 sm:py-12 md:py-16 site-container">
    <div class="space-y-6 sm:space-y-8 mb-8">
      <SectionHeader title={title} description={description}/>
    </div>

    <!-- Gallery Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6">
        {designs.map((item, index) => (
            <div 
                class="gallery-item group relative bg-bg-secondary/75 dark:bg-bg-secondary-dark rounded-xl overflow-hidden border border-primary/15 dark:border-neutral-700/50 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-md"
                data-aos="fade-up-sm"
                data-aos-delay={100 * (index + 1)}
                data-aos-duration="600"
                data-aos-once="true"
            >
                <div class="aspect-video w-full overflow-hidden bg-neutral-100 dark:bg-neutral-800 relative">
                    <img 
                        src={item.src} 
                        alt={item.title} 
                        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                        loading="lazy"
                    />
                    <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end p-4">
                        <span class="text-white text-sm font-medium font-brand">{item.title}</span>
                    </div>
                </div>
            </div>
        ))}
    </div>

    <!-- Behance Button matching the Blog section style -->
    <div 
        class="flex justify-center mt-12 mb-12"
        data-aos="fade-up-sm"
        data-aos-duration="600"
        data-aos-once="true"
    >
        <Button 
            url="https://www.behance.net/kezayaaaa" 
            target="_blank" 
            rel="noopener noreferrer" 
            className="w-full max-w-72"
        >
            View Full Portfolio on Behance
        </Button>
    </div>
</section>