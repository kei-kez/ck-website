---
import Button from "../components/ui/Button.astro";
import { siteConfig } from "@/config/site";
import HeroCard from "@/components/home/HeroCard.astro";
import Layout from "@/layouts/Layout.astro";
import FeaturedWork from "../components/sections/FeaturedWork.astro";
import BlogSection from "@/components/sections/BlogSection.astro";
import SocialCard from "@/components/cards/SocialCard.astro";
import AnimatedText from "@/components/ui/AnimatedText.astro";
import Explore from "@/components/sections/Explore.astro";
import DesignGallery from "@/components/sections/DesignGallery.astro";

const base = import.meta.env.BASE_URL;
---

<Layout
  title="CK"
  description="Welcome to CK's portfolio site! Explore my work as a Computer Engineer and developer specializing in web applications and interactive geospatial mapping."
  keywords="CK, Portfolio, Web Design, UI Design, Frontend Development, Computer Engineer, GIS"
>
  <div
    class="relative site-container z-20 w-full mx-auto mt-16 px-4 md:mt-18 lg:mt-20 xl:px-0"
  >
    <div class="relative w-full px-4 flex flex-col items-center justify-between md:flex-row mb-16">
      
      <!-- Left Column: Intro Text & Socials -->
      <div class="relative w-full md:max-w-[420px] md:w-1/2 text-center sm:text-left sm:-mt-8">
        <!-- Title -->
        <h1 class="mb-4">
          <AnimatedText
            content="Hi, I'm CK"
            delay={0.1}
            duration={0.5}
            stagger={0.08}
            class="text-5xl text-pri leading-tight md:text-4xl lg:text-6xl font-brand "
          />
        </h1>

        <!-- First description -->
        <div class="mb-2">
          <AnimatedText
            content="A results-driven Computer Engineer and developer specializing in robust web applications, frontend solutions, and interactive geospatial mapping. Passionate about turning complex technical challenges into clean, reliable, and user-focused digital experiences."
            delay={0.3}
            duration={0.5}
            stagger={0.015}
            class="text-base text-neutral-700 dark:text-neutral-300"
          />
        </div>

        <!-- Second description -->
        <div class="mb-4">
          <AnimatedText
            content="I believe great design should be both delightful and solve real-world challenges."
            delay={0.5}
            duration={0.5}
            stagger={0.015}
            class="text-base text-neutral-700 dark:text-neutral-300"
          />
        </div>

        <!-- Button -->
        <div
          class=""
          data-aos="fade-up-sm"
          data-aos-delay="900"
          data-aos-duration="500"
          data-aos-once="true"
        >
          <Button url="https://www.linkedin.com/in/chenaniah-keziah-p-771749276" type="fill" className="m-auto mt-4 text-center sm:text-left sm:m-0 sm:mt-6 max-w-[220px]">
            Connect on LinkedIn
          </Button>
        </div>

        <!-- Social Cards -->
        <div
          class="social mt-8 mb-8"
          data-aos="fade-up-sm"
          data-aos-delay="1000"
          data-aos-duration="600"
          data-aos-once="true"
        >
          <SocialCard displaySocialIds={[1, 2, 3]}/>
        </div>
      </div>

      <!-- Right Column: Profile Picture (HeroCard Restored) -->
      <div
        class="relative justify-end w-full mt-16 md:flex md:pl-10 md:w-1/2 md:mt-0 md:translate-y-4 xl:translate-y-0"
        data-aos="fade-left-sm"
        data-aos-delay="300"
        data-aos-duration="800"
        data-aos-once="true"
      >
        <HeroCard
          imageUrl={`${base}/assets/home/profile-pic.png`}
          title="CK"
          link={siteConfig.social.github}
        />
      </div>

    </div>
  </div>

  <section
    class="mt-26 mb-12"
    data-aos="fade-up-sm"
    data-aos-delay="100"
    data-aos-duration="600"
    data-aos-once="true"
  >
    <Explore title="Explore ↓" />
  </section>

  <section
    class="mt-26 mb-12"
    data-aos="fade-up-sm"
    data-aos-delay="100"
    data-aos-duration="600"
    data-aos-once="true"
  >
    <DesignGallery />
  </section>
  
  <section
    class="mt-26 mb-12"
    data-aos="fade-up-sm"
    data-aos-delay="100"
    data-aos-duration="600"
    data-aos-once="true"
  >
    <FeaturedWork title="Featured Work ↓" description="I create innovative and purposeful designs that not only capture attention but also drive meaningful results." limit={5} />
  </section>

  <section
    class="mt-26 mb-12"
    data-aos="fade-up-sm"
    data-aos-delay="100"
    data-aos-duration="600"
    data-aos-once="true"
  >
    <BlogSection
      title="Latest Articles  ↓"
      description="These are my notes and articles on design, development and life thinking."
      showViewAllButton={true}
    />
  </section>
</Layout>